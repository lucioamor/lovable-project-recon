# --- recon `db` mode (read-only) ---
# A read-only Postgres connection string to a Lovable Cloud (Supabase) project.
# Prefer a role with SELECT-only grants. recon runs everything inside a READ ONLY
# transaction with a statement timeout, and never issues INSERT/UPDATE/DDL.
SUPABASE_DB_URL=postgresql://readonly:password@db.<ref>.supabase.co:5432/postgres

# --- recon `portfolio` mode (later milestone) ---
# Authorized Lovable session token, captured with explicit consent via the
# extension. M0 does not use this — portfolio mode is stubbed.
# LOVABLE_TOKEN=
